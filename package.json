{
  "name": "chatverse",
  "version": "2.0.0",
  "description": "ChatVerse: a research-grade, end-to-end encrypted real-time messaging platform with ordered delivery, resumable sync and reproducible benchmarks",
  "private": true,
  "license": "MIT",
  "author": "Satvik Praveen <satvikpraveen707@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/SatvikPraveen/ChatVerse.git"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @chatverse/api dev",
    "dev:web": "pnpm --filter @chatverse/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "pnpm --filter @chatverse/e2e test:e2e",
    "bench": "pnpm --filter @chatverse/bench run bench",
    "docker:dev": "docker compose -f infra/docker/docker-compose.dev.yml up --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "seed": "pnpm --filter @chatverse/api seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3"
}
