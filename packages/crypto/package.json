{
  "name": "@chatverse/crypto",
  "version": "2.0.0",
  "description": "End-to-end encryption for ChatVerse: X3DH key agreement, Double Ratchet sessions and Sender Keys for groups, built on audited @noble primitives and usable in browsers and Node",
  "license": "MIT",
  "author": "Satvik Praveen <satvikpraveen707@gmail.com>",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chatverse/protocol": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@chatverse/eslint-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
