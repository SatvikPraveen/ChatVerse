{
  "name": "@chatverse/types",
  "version": "1.0.0",
  "description": "Shared TypeScript types and interfaces for ChatVerse",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./socket": {
      "types": "./dist/socket.d.ts",
      "default": "./dist/socket.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "keywords": ["typescript", "types", "chat", "shared"],
  "author": "ChatVerse Team",
  "license": "MIT"
}
