# Root .env.example — the API reads apps/api/.env (see apps/api/.env.example for every option);
# this file documents the minimum needed to run the whole stack locally.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
NODE_ID=api-local
MONGODB_URI=mongodb://localhost:27017/chatverse
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-access
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-refresh
CORS_ORIGINS=http://localhost:5173

# --- Web (apps/web) ---
VITE_API_URL=http://localhost:4000
