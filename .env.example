# ChatVerse environment reference. Copy to .env (root) or apps/api/.env for local development.
# Values below match infra/docker/docker-compose.dev.yml so `./scripts/dev.sh` works unchanged.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development                # development | test | production
HOST=0.0.0.0
PORT=4000
# Stable, unique identifier per server instance; used in HLC timestamps, logs and metrics.
# Leave empty to derive one from the hostname + pid.
NODE_ID=api-local

# --- Data stores --------------------------------------------------------------
MONGODB_URI=mongodb://chatverse:chatverse123@localhost:27017/chatverse?authSource=admin
REDIS_URL=redis://:chatverse123@localhost:6379/0

# --- Auth --------------------------------------------------------------------
# Both secrets must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SEC=900            # 15 minutes
REFRESH_TOKEN_TTL_SEC=2592000       # 30 days; refresh tokens rotate on every use

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of allowed browser origins (REST + Socket.IO).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=debug                     # fatal | error | warn | info | debug | trace
# Number of trusted reverse proxies in front of the API (Express "trust proxy"). 0 = none.
TRUST_PROXY=0
# Per-IP request budget for the REST API (sliding window).
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
# Expose Prometheus metrics on GET /metrics.
METRICS_ENABLED=true

# --- Attachments (S3-compatible; MinIO locally) --------------------------------
S3_ENDPOINT=http://localhost:9000   # leave empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET=chatverse-uploads
S3_ACCESS_KEY_ID=chatverse
S3_SECRET_ACCESS_KEY=chatverse123
# Base URL clients use to fetch uploaded objects.
S3_PUBLIC_URL=http://localhost:9000/chatverse-uploads

# --- Web push (optional; generate with: npx web-push generate-vapid-keys) ---------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@chatverse.local

# --- Retention ------------------------------------------------------------------
# Messages older than this are expired by a TTL index. 0 disables expiry.
MESSAGE_RETENTION_DAYS=365

# --- Web client (apps/web/.env; Vite only exposes VITE_* variables) ----------------
# Empty means same origin (nginx / Vite dev proxy forwards /api and /socket.io).
VITE_API_URL=http://localhost:4000
VITE_VAPID_PUBLIC_KEY=
