# Base URL of the ChatVerse API (REST under /api/v1, Socket.IO at the root).
# Leave unset in development: the Vite dev server proxies /api and /socket.io to localhost:4000.
VITE_API_URL=http://localhost:4000

# Public VAPID key for Web Push (must match the server's VAPID_PUBLIC_KEY). Optional.
VITE_VAPID_PUBLIC_KEY=
