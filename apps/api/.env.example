# apps/api/.env.example — copy to .env for local development

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Identifies this server instance in HLC timestamps and health output (defaults to hostname)
NODE_ID=api-local

# Storage
MONGODB_URI=mongodb://localhost:27017/chatverse
# Optional. When unset the server runs with in-process sequencing/presence (single node only).
REDIS_URL=redis://localhost:6379

# Auth (secrets must be >= 32 characters)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-access
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-refresh
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# HTTP
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
LOG_LEVEL=info
METRICS_ENABLED=true

# Object storage for attachments (optional; uploads are disabled when unset)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatverse-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=http://localhost:9000/chatverse-uploads

# Web push (optional; generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Message retention in days (0 keeps messages forever)
MESSAGE_RETENTION_DAYS=0
